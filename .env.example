# Copy to .env and fill in. Never commit your real .env.

# Port the server listens on
PORT=8080

# Public URL people use to reach the server (used for Google sign-in redirects and passkeys)
PUBLIC_URL=http://localhost:8080

# Where the SQLite database lives
DATA_DIR=./data

# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google sign-in (OIDC). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any OpenID Connect provider (Authentik, Authelia, Keycloak, Pocket ID...). See docs/single-sign-on.md
# Redirect URI: ${PUBLIC_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
OIDC_SCOPES=

# Forward-auth from a reverse proxy (TinyAuth, Authelia, oauth2-proxy). Off unless FORWARD_AUTH_HEADER is set.
# Only requests coming straight from FORWARD_AUTH_TRUSTED addresses may use the header.
FORWARD_AUTH_HEADER=
FORWARD_AUTH_EMAIL_HEADER=
FORWARD_AUTH_NAME_HEADER=
FORWARD_AUTH_TRUSTED=

# Who can create a parent account: invite (needs a home join code, the default), open, or closed.
# The very first account can always be created and becomes the admin. Admins can change this in Settings.
SIGNUP_MODE=invite

# Name-only "quick sign-in" for parents: lan (home network addresses only, the default without Google), off, or anywhere.
# Never use "anywhere" on a server that's reachable from the internet.
LOCAL_LOGIN=

# Reverse proxies whose X-Forwarded-* headers are trusted. Defaults to loopback + private networks.
TRUST_PROXY=

# Time zone for new homes when the browser doesn't send one (each home can change it in Settings).
TZ=
