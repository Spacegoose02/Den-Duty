{
  "name": "@den-duty/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Den Duty desktop app",
  "author": "Den Duty contributors",
  "license": "MIT",
  "repository": "github:Spacegoose02/Den-Duty",
  "main": "main.cjs",
  "scripts": {
    "copy-launcher": "node -e \"require('fs').cpSync('../launcher','launcher',{recursive:true})\"",
    "start": "npm run copy-launcher && electron .",
    "dist": "npm run copy-launcher && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run copy-launcher && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run copy-launcher && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.denduty.desktop",
    "productName": "Den Duty",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "launcher/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DenDuty-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DenDuty-Portable-${version}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png"
    }
  }
}
