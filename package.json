{
  "name": "den-duty",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, tablet-first family chore tracker: chores, points, goals and rewards, run by a raccoon.",
  "license": "MIT",
  "workspaces": [
    "server",
    "web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm start --workspace server",
    "test": "node --test \"shared/**/*.test.ts\" \"server/src/**/*.test.ts\"",
    "typecheck": "tsc -p server && tsc -p web --noEmit",
    "icons": "node scripts/brand.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
